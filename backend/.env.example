# Copy this file to backend/.env and fill in your key. Never commit .env.
# Free key: https://aistudio.google.com/apikey  (the app works without it; the AI summary is skipped)
GEMINI_API_KEY=
# Which Gemini model writes the summary (calls use the v1beta API, so preview models work).
# Switch to a stable model later by changing this line, e.g. GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3-flash-preview
# Optional: max sales upload size in MB, and allowed frontend origins (comma-separated)
MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173
